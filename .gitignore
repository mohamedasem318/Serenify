# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
!.env.local.example

# SSH / private keys — never commit. Real keys live in ~/.ssh (off-repo);
# this is defense-in-depth so a stray copy can't be `git add`-ed by accident.
*.pem
*.key
*.p12
*.pfx
id_ed25519
id_rsa
id_ecdsa
id_dsa
*_rsa
*_ed25519
.ssh/

# Python (FastAPI service + ml-video package land in feature 004)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
*.lcov

# Supabase local CLI
supabase/.branches/
supabase/.temp/
supabase/snippets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project-specific
specs/.staging/

# Disposable spike scaffolding + dev mocks — never commit. Two such artifacts
# (the _scratch-008-continuous-spike/ harness + serenify-008-*mock*.html) rode into
# main via the 008 squash; these guards stop that class of scratch from recurring.
_scratch-*/
serenify-008-*mock*.html

# Model-artifact staging drop (committed artifacts live in packages/ml-*/models/)
tmp/

# Local debug screenshots (root-level repro captures, not committed)
bug-repro-no-notice.png
fix-notice-light.png

# Smoke-test scripts and outputs (live on chore/smoke-test-scripts off main)
st1-*.js
st1-shots/

# 008 live-smoke / validation / keep-up local scratch — probe scripts, run logs,
# env backups, pid files. Machine-generated; never commit (would otherwise ride a
# squash-merge to main). NOTE: loose 008 reference .html files are intentionally
# NOT ignored — they are design references (incl. serenify-008followups-trend-FINAL.html,
# the visual authority); leave those decisions to a human.
.smoke_*/
.azure_keepup_*/
.validation_*/

# Claude Code: per-user local settings only; track everything else under .claude/
# See 7a7beff (PR #3) and DECISIONS.md @ 512c1d6 — never broaden back to `.claude/`
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Playwright MCP server cache
.playwright-mcp/

# SpecKit per-branch state (the constitution at .specify/memory/ stays tracked)
.specify/feature.json
