# Copy to scripts/seed/.env.local (gitignored) and fill in real values.
# Never commit real values for these — see constitution Principle IX.

# Local:    http://127.0.0.1:54321 (from `supabase start`)
# Deployed: https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key for the target project above. Local: from `supabase start`
# output. Deployed: from the Supabase dashboard → Project Settings → API.
# NEVER the anon key — account creation requires the admin API.
SUPABASE_SERVICE_ROLE_KEY=

# No password var here: each created account's password is set to its own
# email (operator decision — see seed-accounts.ts). Accounts are created
# with email_confirm=true so that login works immediately.
