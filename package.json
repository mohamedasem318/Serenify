{
  "name": "serenify",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "seed": "tsx scripts/seed-demo.ts",
    "seed:reset": "tsx scripts/seed-demo.ts --reset",
    "seed:accounts": "tsx scripts/seed/seed-accounts.ts",
    "seed:accounts:local-reset": "supabase db reset && npm run seed:accounts",
    "check:speckit-skills": "node --test scripts/check-speckit-skills.test.mjs && node scripts/check-speckit-skills.mjs",
    "check:progress-freshness": "node --test scripts/check-progress-freshness.test.mjs && node scripts/check-progress-freshness.mjs",
    "test:seed": "vitest run",
    "test:seed:integration": "cross-env SUPABASE_INTEGRATION=1 vitest run"
  },
  "devDependencies": {
    "@faker-js/faker": "9.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "supabase": "2.114.0",
    "tsx": "4.22.3",
    "vitest": "^4.1.6"
  }
}
