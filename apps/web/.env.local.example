# Copy to .env.local and fill from `supabase start` output.
# .env.local is gitignored (see repo-root .gitignore).

# Public — exposed to the browser; safe to ship.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER imported by a client component.
# Used by apps/web/lib/supabase/admin.ts (POST /api/admin/invite) and
# by apps/web/tests/e2e/setup/admin-client.ts (Playwright test setup).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for Supabase auth redirects (emailRedirectTo, resetPasswordForEmail).
SITE_URL=http://localhost:3000
