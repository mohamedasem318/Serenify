# Copy to .env.local and fill from `supabase start` output.
# .env.local is gitignored (see repo-root .gitignore).

# Local Supabase keys are printed by `supabase start` — copy the public values
# into the two lines below. The validated env module rejects empty public values
# at boot.

# Public — exposed to the browser; safe to ship.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI anchor service origin (feature 004). Defaults to this dev value if
# unset; the CSP connect-src is derived from it. KEEP THIS — and the origin you
# open the app at — on localhost/127.0.0.1: the camera (getUserMedia) only works in
# a SECURE CONTEXT (localhost/127.0.0.1 or HTTPS), so loading from a LAN IP over
# plain http blocks recording, and a LAN-IP API URL needs the backend bound to
# 0.0.0.0 (uvicorn --host 0.0.0.0) or it's connection-refused. LAN/phone testing
# needs HTTPS — see apps/web/README "Device / phone camera testing". Production
# sets the deployed origin.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Base URL for Supabase auth redirects (emailRedirectTo, resetPasswordForEmail).
SITE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Test-only / infrastructure (defaults shown; none required to run the app).
# Listed for discoverability — the code falls back to these defaults, so you
# normally do not need to set them locally.
# --------------------------------------------------------------------------
# PLAYWRIGHT_PORT=3000                 # dev-server port Playwright targets
# CI=                                  # truthy in CI (auto-set by GitHub Actions)
# MAILPIT_URL=http://127.0.0.1:54324   # Mailpit inbox the e2e tests poll
# TEST_ADMIN_EMAIL=                    # set in-process by tests/e2e/setup/global-setup.ts
# TEST_ADMIN_PASSWORD=                 # set in-process by global-setup.ts
# SUPABASE_SERVICE_ROLE_KEY=           # test-only: Playwright seed helpers
# SUPABASE_PROJECT_REF=                # only for `npm run seed -- --remote`
