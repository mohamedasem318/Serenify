# Serenify Anchor API — copy to .env and fill in. Never commit real values.

# Legacy HS256 secret — the symmetric verification fallback for projects that
# still sign access tokens HS256. Supabase dashboard: Project Settings -> API ->
# JWT Settings -> JWT Secret. (Local CLI default below.)
SUPABASE_JWT_SECRET=

# Web origins allowed by CORS — comma-separated; each must equal an origin you LOAD
# the app at (the page origin), NOT the API host. NO trailing slash (the browser
# matches the Origin exactly). List localhost AND a LAN origin so desktop-localhost
# and device-LAN both work without re-toggling. LAN/device also needs HTTPS for the
# camera — see apps/web/README. (Legacy singular ALLOWED_ORIGIN is still accepted.)
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.x.x:3000

# Supabase project base URL — used to fetch the JWKS public keys that verify the
# asymmetric ES256 access tokens current Supabase issues by default AND, since
# feature 008, as the PostgREST base for the user-context client. REQUIRED (no
# longer optional). Dev (local Supabase CLI): http://127.0.0.1:54321.
SUPABASE_URL=http://127.0.0.1:54321

# Supabase PUBLISHABLE anon key — the SAME value the web app uses as
# NEXT_PUBLIC_SUPABASE_ANON_KEY (apps/web/.env.local). Feature 008 sends it as the
# PostgREST `apikey` alongside the forwarded user JWT (revised D-1): it is
# RLS-respecting and grants nothing on its own, so it is NOT a secret — and it is
# NOT the service-role key (deliberately absent from this service). REQUIRED — the
# API will not start without it. For the local Supabase CLI this is the well-known
# demo anon key printed by `supabase status`.
SUPABASE_ANON_KEY=
