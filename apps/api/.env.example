# Serenify Anchor API — copy to .env and fill in. Never commit real values.

# Legacy HS256 secret — the symmetric verification fallback for projects that
# still sign access tokens HS256. Supabase dashboard: Project Settings -> API ->
# JWT Settings -> JWT Secret. (Local CLI default below.)
SUPABASE_JWT_SECRET=

# Web origins allowed by CORS — comma-separated; each must equal an origin you LOAD
# the app at (the page origin), NOT the API host. NO trailing slash (the browser
# matches the Origin exactly). List localhost AND a LAN origin so desktop-localhost
# and device-LAN both work without re-toggling. LAN/device also needs HTTPS for the
# camera — see apps/web/README. (Legacy singular ALLOWED_ORIGIN is still accepted.)
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.x.x:3000

# Supabase project base URL — used to fetch the JWKS public keys that verify the
# asymmetric ES256 access tokens current Supabase issues by default AND, since
# feature 008, as the PostgREST base for the user-context client. REQUIRED (no
# longer optional). Dev (local Supabase CLI): http://127.0.0.1:54321.
SUPABASE_URL=http://127.0.0.1:54321

# Supabase PUBLISHABLE anon key — the SAME value the web app uses as
# NEXT_PUBLIC_SUPABASE_ANON_KEY (apps/web/.env.local). Feature 008 sends it as the
# PostgREST `apikey` alongside the forwarded user JWT (revised D-1): it is
# RLS-respecting and grants nothing on its own, so it is NOT a secret — and it is
# NOT the service-role key (deliberately absent from this service). REQUIRED — the
# API will not start without it. For the local Supabase CLI this is the well-known
# demo anon key printed by `supabase status`.
SUPABASE_ANON_KEY=

# ── Feature 011 — Ren chat / llm-client ────────────────────────────────────
# These are read by the `llm_client` package via os.environ directly — NOT through
# the pydantic Settings above. So unlike the vars above, putting them in this file
# is NOT enough on its own: the API process must be LAUNCHED with this file loaded
# into its environment, e.g. `uv run --env-file .env uvicorn ...` (the plain
# `uv run uvicorn ...` command leaves GROQ_API_KEY unset → fail-clean → Ren can't
# reply). Server-side ONLY — none of these is ever exposed to the browser; nothing
# chat-related ships as a NEXT_PUBLIC_* var.

# Groq primary-provider API key (secret; env-only, never committed). Get one from
# the Groq console. Absent key is tolerated at import but fails clean at call time.
GROQ_API_KEY=

# Fail-clean vs silent fallback (FR-003). Default (unset/false) = FAIL-CLEAN: if the
# primary provider is down the API errors into a calm degraded state rather than
# silently dropping to the fallback. Set to "true"/"1" only to allow silent fallback.
LLM_SILENT_FALLBACK=false

# The ONE configured bot display name (FR-006). Default "Ren"; never hardcode it
# elsewhere.
LLM_BOT_NAME=Ren

# ── Feature 014 — reflective copy (the "Things that might help" card) ──────
# A SECOND key to the SAME provider (Groq), used only to re-phrase the card's
# deterministic sentence in states 2 and 9 (Amendment 3, 2026-08-16). It exists so card
# copy can never consume Ren's rate limit: a conversation must not go quiet because a
# card was chatty. GROQ_API_KEY above is NEVER read on this path, and this key is never
# read on Ren's.
#
# Leaving it blank is a SUPPORTED state, not a broken one: the provider errors at request
# time, POST /recommendations/reflective-copy returns 502, and the card paints its
# reviewed deterministic string — which is the source of truth for what is said anyway.
# Nothing else about the card changes. Same launch note as the block above: the API
# process must be LAUNCHED with this file loaded (`uv run --env-file .env uvicorn ...`).
GROQ_API_KEY_REFLECTIVE_COPY=

# Optional overrides (defaults shown; you normally do NOT need to set these). The
# LM_STUDIO_* fallback is only consulted when LLM_SILENT_FALLBACK is on. Note that the
# GROQ_* and LLM_* values below are SHARED by both paths — same provider, same model,
# same timeout and retry behaviour; only the credential differs.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=
# LM_STUDIO_MODEL=openai/gpt-oss-20b
# LLM_REQUEST_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
