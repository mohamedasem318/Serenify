# Serenify Anchor API — copy to .env and fill in. Never commit real values.

# HS256 secret Supabase uses to sign access tokens.
# Supabase dashboard: Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# Web origin allowed by CORS. Dev: http://127.0.0.1:3000
ALLOWED_ORIGIN=
